<div class="container mt-4">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0">Attendance</h1>
    <div class="attendance-actions">
      <%= button_to "Check In", check_in_attendances_path, method: :post,
            class: "btn btn-outline-success d-flex align-items-center gap-2" %>
    </div>
  </div>

  <%# Filter form %>
 <%if current_user.admin? || current_user.hr? %> 
  <div class="card mb-4">
    <div class="card-body">
      <%= form_with url: attendances_path, method: :get, local: true do |f| %>
        <div class="row g-3 align-items-end">
          <div class="col-md-4">
            <%= f.label :date, "Date", class: "form-label" %>
            <%= f.date_field :date, value: params[:date], class: "form-control" %>
          </div>
          <div class="col-md-4">
            <%= f.label :employee_id, "Employee", class: "form-label" %>
            <%= f.select :employee_id,
                  options_from_collection_for_select(User.all, :id, :name, params[:employee_id]),
                  { include_blank: "All" },
                  { class: "form-select" } %>
          </div>
          <div class="col-md-4">
            <%= f.submit "Filter", class: "btn btn-outline-dark w-50 " %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
  <% end %>

  <%# Attendance table %>
  <div class="card mb-4 shadow-sm border-3 ">
    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle mb-0">
        <thead class="table-dark text-uppercase small fw-bold hover-table-header">
          <tr>
            <th>Date</th>
            <th>Employee</th>
            <th>Check In</th>
            <th>Check Out</th>
            <th>Working Hours</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @attendances.each do |attendance| %>
            <tr>
              <td><%= attendance.attendance_date %></td>
              <td><%= attendance.user.try(:name) || "—" %></td>
              <td><%= attendance.check_in.present? ? l(attendance.check_in, format: :short) : "—" %></td>
              <td Class="text-bold"><%= attendance.check_out.present? ? l(attendance.check_out, format: :short) : "in-progress" %></td>
              <td><%= attendance.working_hours.present? ? attendance.working_hours : "—" %></td>
              <td>
                <%
                  badge_class = case attendance.status
                    when "present"     then "bg-success"
                    when "absent"      then "bg-danger"
                    when "in_progress" then "bg-warning text-dark"
                    else "bg-secondary"
                  end
                %>
                <span class="badge <%= badge_class %>"><%= attendance.status %></span>
              </td>
              <td>
                <% if current_user_detail.present? &&
                      attendance.user_id == current_user_detail.id &&
                      attendance.check_out.blank? %>
                  <%= button_to "Check Out", check_out_attendance_path(attendance),
                        method: :patch, class: "btn btn-sm btn-warning rounded-pill" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      
    </div>
  </div>
 <div class="d-flex justify-content-between align-items-center mt-3">
  <span>
    <%= link_to "<- Back", root_path %>
  </span>

  <span>
    <%= paginate @attendances %>
  </span>
</div>
  
</div>