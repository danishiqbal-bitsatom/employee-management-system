<div class="container mt-4">
  <h1 class="fw-bold">Department Details</h1>

  <div class="card mt-3">
    <div class="card-body">
      <h5 class="card-title"><%= @department.name %></h5>

      <h6 class="mt-3">Employees:</h6>
      <% if @department.users.any? %>
        <ul class="list-group">
          <% @department.users.each do |employee| %>
            <li class="list-group-item"><%= employee.name %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-muted">No employees in this department.</p>
      <% end %>
    </div>
  </div>

  <div class="mt-3">
    <%= link_to "Edit", edit_department_path(@department), class: "btn btn-warning btn-sm" %>
    <%= link_to "Back", departments_path, class: "btn btn-secondary btn-sm" %>
  </div>
</div>