<div class="container mt-4">
   <div class="d-flex justify-content-end mb-3">
</div>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="fw-bold">Departments</h1>
    <span class="ms-auto">
      <%= link_to "New Department", new_department_path, class: "btn btn-outline-primary rounded-pill" %>
      <%=link_to "Back to Employees", user_details_path, class: "btn btn-outline-info btn-md rounded-pill" %>
    </span>
  </div>

  <table class="table table-bordered table-hover">
    <thead class="table-dark">
      <tr>
        <th>id</th>
        <th>Name</th>
        <th >Actions</th>
        
      </tr>
    </thead>
    <tbody>
      <% @departments.each_with_index do |department, index| %>
        <tr>
          <td><%= index + 1 %></td>
          <td><%= department.name %></td>
          <td class="d-flex gap-2"> 
            <%= link_to "Show", department_path(department), class: "btn btn-info btn-sm" %>
            <%= link_to "Edit", edit_department_path(department), class: "btn btn-warning btn-sm" %>
            <%= button_to "Delete", department_path(department), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-danger btn-sm" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  
</div>