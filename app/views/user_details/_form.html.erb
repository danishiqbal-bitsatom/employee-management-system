
  <% if employee.errors.any? %>
    <div class="alert alert-danger">
      <strong> Please fix these errors:</strong>
      <ul class="mb-0 mt-1">
        <% employee.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
          <% end %>
      </ul>
    </div>
    <% end %>
    
  <div class="row g-3">
    <div class="col-md-6">
      <%= f.label :name, class: "form-label fw-semibold" %>
      <%= f.text_field :name, class: "form-control", placeholder: "e.g. Rahul Sharma" %>
    </div>

    <div class="col-md-6">
      <%= f.label :email, class: "form-label fw-semibold" %>
      <%= f.email_field :email, class: "form-control", placeholder: "e.g. rahul@company.com" %>
    </div>

    <div class="col-md-4">
      <%= f.label :employee_id, "Employee ID", class: "form-label fw-semibold" %>
      <%= f.text_field :employee_id, class: "form-control", placeholder: "e.g. EMP001" %>
    </div>

    <div class="col-md-4">
      <%= f.label :phone, class: "form-label fw-semibold" %>
      <%= f.text_field :phone, class: "form-control", placeholder: "+91 9876543210" %>
    </div>

    <div class="col-md-4">
      <%= f.label :designation, class: "form-label fw-semibold" %>
      <%= f.text_field :designation, class: "form-control", placeholder: "e.g. Software Engineer" %>
    </div>

    <div class="col-md-6">
      <%= f.label :joining_date, class: "form-label fw-semibold" %>
      <%= f.date_field :joining_date, class: "form-control" %>
    </div>

    <div class="col-md-6">
      <%= f.label :status, class: "form-label fw-semibold" %>
      <%= f.select :status,
            [["Active", "active"], ["Inactive", "inactive"]],
            { prompt: "Select status" },
            class: "form-select" %>
    </div>

    <div class="col-md-12">
      <%= f.label :department_id, "Department", class: "form-label fw-semibold" %>
      <%= f.collection_select :department_id, Department.all, :id, :name, { prompt: "Select department" }, class: "form-select" %>
    </div>
  </div>

  <div class="mt-4 d-flex gap-2">
    <%= f.submit class: "btn btn-success px-4" %>
    <%= link_to "Cancel", user_details_path, class: "btn btn-secondary" %>
  </div>
