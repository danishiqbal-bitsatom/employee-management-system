<div class="container mt-4">
<div class="card shadow-sm">
  <div class="card-header d-flex justify-content-between align-items-center bg-dark text-white">
    <h4 class="mb-0"><%= @employee_detail.name %></h4>
    <span class="badge bg-<%= @employee_detail.status == 'active' ? 'success' : 'danger' %>">
      <%= @employee_detail.status %>
    </span>
  </div>
  <div class="card-body">
    <dl class="row">
      <dt class="col-sm-3">Employee ID</dt>
      <dd class="col-sm-9"><%= @employee_detail.employee_id %></dd>

      <dt class="col-sm-3">Email</dt>
      <dd class="col-sm-9"><%= @employee_detail.email %></dd>

      <dt class="col-sm-3">Phone</dt>
      <dd class="col-sm-9"><%= @employee_detail.phone %></dd>

      <dt class="col-sm-3">Designation</dt>
      <dd class="col-sm-9"><%= @employee_detail.designation %></dd>

      <dt class="col-sm-3">Joining Date</dt>
      <dd class="col-sm-9"><%= @employee_detail.joining_date&.strftime("%d %B %Y") %></dd>
    </dl>
  </div>
  <div class="card-footer d-flex gap-2">

    <% if current_user.admin? || current_user.hr? %>
      <%= link_to "Edit",   edit_user_detail_path(@employee_detail), class: "btn btn-warning" %>
    <% end %>
    
    <%= link_to "Back",   user_details_path, class: "btn btn-secondary" %>
  </div>
</div>
</div>